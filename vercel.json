{
  "version": 2,
  "buildCommand": "echo 'No build needed for static files'",
  "outputDirectory": ".",
  "functions": {
    "api/gmb-reviews.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/gmb-reviews",
      "dest": "/api/gmb-reviews.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/portfolio",
      "dest": "/portfolio.html"
    },
    {
      "src": "/services",
      "dest": "/services.html"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "src": "/blog",
      "dest": "/blog.html"
    },
    {
      "src": "/blog/(.*)",
      "dest": "/blog/$1"
    },
    {
      "src": "/(.*)\\.html",
      "status": 301,
      "headers": {
        "Location": "/$1"
      }
    }
  ]
}
