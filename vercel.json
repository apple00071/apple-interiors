{
  "buildCommand": "echo 'Build complete'",
  "outputDirectory": ".",

  "rewrites": [
    {
      "source": "/(about|services|portfolio|contact)",
      "destination": "/$1.html"
    },
    {
      "source": "/interior-designers-in-kukatpally",
      "destination": "/interior-designers-in-kukatpally.html"
    },
    {
      "source": "/interior-designers-in-gachibowli",
      "destination": "/interior-designers-in-gachibowli.html"
    },
    {
      "source": "/interior-designers-in-hitec-city",
      "destination": "/interior-designers-in-hitec-city.html"
    },
    {
      "source": "/interior-designers-in-madhapur",
      "destination": "/interior-designers-in-madhapur.html"
    },
    {
      "source": "/interior-designers-in-kphb",
      "destination": "/interior-designers-in-kphb.html"
    },
    {
      "source": "/interior-designers-in-kondapur",
      "destination": "/interior-designers-in-kondapur.html"
    },
    {
      "source": "/interior-designers-in-banjara-hills",
      "destination": "/interior-designers-in-banjara-hills.html"
    },
    {
      "source": "/interior-designers-in-jubilee-hills",
      "destination": "/interior-designers-in-jubilee-hills.html"
    },
    {
      "source": "/api/contact",
      "destination": "/api/contact.js"
    },
    {
      "source": "/api/gmb-reviews",
      "destination": "/api/gmb-reviews.js"
    },
    {
      "source": "/api/csrf-token",
      "destination": "/api/csrf-token.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
