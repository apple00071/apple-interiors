{
  "buildCommand": "echo 'Build complete'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(about|services|portfolio|contact)",
      "destination": "/$1.html"
    },
    {
      "source": "/api/contact",
      "destination": "/api/contact.js"
    },
    {
      "source": "/api/gmb-reviews",
      "destination": "/api/gmb-reviews.js"
    },
    {
      "source": "/api/csrf-token",
      "destination": "/api/csrf-token.js"
    }
  ],
  "routes": [
    {
      "src": "/404",
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "/(.*)\\.html$",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    {
      "src": "/_next/static/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/static/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "dest": "/index.html"
    }
  ]
}
