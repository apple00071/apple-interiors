{
  "buildCommand": "echo 'Build complete'",
  "outputDirectory": ".",

  "rewrites": [
    {
      "source": "/(about|services|portfolio|contact)",
      "destination": "/$1.html"
    },
    {
      "source": "/api/contact",
      "destination": "/api/contact.js"
    },
    {
      "source": "/api/gmb-reviews",
      "destination": "/api/gmb-reviews.js"
    },
    {
      "source": "/api/csrf-token",
      "destination": "/api/csrf-token.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
