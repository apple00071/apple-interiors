{
  "buildCommand": "echo 'Build complete'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/about/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/feed",
      "destination": "/404",
      "statusCode": 410
    },
    {
      "source": "/interior-designers-kukatpally",
      "destination": "/interior-designers-in-kukatpally",
      "permanent": true
    },
    {
      "source": "/interior-designers-gachibowli",
      "destination": "/interior-designers-in-gachibowli",
      "permanent": true
    },
    {
      "source": "/interior-designers-hitec-city",
      "destination": "/interior-designers-in-hitec-city",
      "permanent": true
    },
    {
      "source": "/interior-designers-madhapur",
      "destination": "/interior-designers-in-madhapur",
      "permanent": true
    },
    {
      "source": "/interior-designers-banjara-hills",
      "destination": "/interior-designers-in-banjara-hills",
      "permanent": true
    },
    {
      "source": "/interior-designers-jubilee-hills",
      "destination": "/interior-designers-in-jubilee-hills",
      "permanent": true
    },
    {
      "source": "/interior-designers-kondapur",
      "destination": "/interior-designers-in-kondapur",
      "permanent": true
    },
    {
      "source": "/interior-designers-kphb",
      "destination": "/interior-designers-in-kphb",
      "permanent": true
    },
    {
      "source": "/:location-interior-designers",
      "destination": "/interior-designers-in-:location",
      "permanent": true
    },
    {
      "source": "/blog/color-palette-trends-2024-hyderabad",
      "destination": "/blog/color-palette-trends-2026-hyderabad",
      "permanent": true
    },
    {
      "source": "/blog/latest-modular-kitchen-trends-2024-hyderabad",
      "destination": "/blog/latest-modular-kitchen-trends-2026-hyderabad",
      "permanent": true
    },
    {
      "source": "/blog/budget-friendly-interior-design-hyderabad",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(about|services|portfolio|contact|index)",
      "destination": "/$1.html"
    },
    {
      "source": "/interior-designers-in-:location",
      "destination": "/interior-designers-in-:location.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/modular-kitchen-hyderabad",
      "destination": "/modular-kitchen-hyderabad.html"
    },
    {
      "source": "/false-ceiling-design-hyderabad",
      "destination": "/false-ceiling-design-hyderabad.html"
    },
    {
      "source": "/complete-home-interiors-hyderabad",
      "destination": "/complete-home-interiors-hyderabad.html"
    },
    {
      "source": "/wardrobe-design-hyderabad",
      "destination": "/wardrobe-design-hyderabad.html"
    },
    {
      "source": "/living-room-interior-design-hyderabad",
      "destination": "/living-room-interior-design-hyderabad.html"
    },
    {
      "source": "/bedroom-interior-design-hyderabad",
      "destination": "/bedroom-interior-design-hyderabad.html"
    },
    {
      "source": "/commercial-interior-design-hyderabad",
      "destination": "/commercial-interior-design-hyderabad.html"
    },
    {
      "source": "/luxury-interior-designers-hyderabad",
      "destination": "/luxury-interior-designers-hyderabad.html"
    },
    {
      "source": "/api/contact",
      "destination": "/api/contact.js"
    },
    {
      "source": "/api/gmb-reviews",
      "destination": "/api/gmb-reviews.js"
    },
    {
      "source": "/api/csrf-token",
      "destination": "/api/csrf-token.js"
    },
    {
      "source": "/case-studies/bandlaguda-dream-home-transformation",
      "destination": "/case-studies/bandlaguda-dream-home-transformation.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}